</sql><sql name="SQL 2*">-- Создаем таблицу рецептов
CREATE TABLE IF NOT EXISTS RECIPE (
    recipe_id INTEGER PRIMARY KEY AUTOINCREMENT,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    cooking_time_minutes INT,
    difficulty VARCHAR(50),
    image_url VARCHAR(500),
    calories_total INT,
    instructions TEXT
);

-- Создаем таблицу связи рецептов с ингредиентами
CREATE TABLE IF NOT EXISTS RECIPE_INGREDIENT (
    recipe_ingredient_id INTEGER PRIMARY KEY AUTOINCREMENT,
    recipe_id BIGINT NOT NULL,
    product_id BIGINT NOT NULL,
    quantity DECIMAL(10, 2) NOT NULL,
    unit VARCHAR(50),
    FOREIGN KEY (recipe_id) REFERENCES RECIPE(recipe_id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES PRODUCTS(id) ON DELETE CASCADE,
    UNIQUE (recipe_id, product_id)
);

-- Вставляем 10 рецептов
INSERT INTO RECIPE (title, description, cooking_time_minutes, difficulty, calories_total, instructions) VALUES
-- Рецепт 1
('Куриная грудка с овощами в сливочном соусе', 'Нежное куриное филе, тушенное с брокколи и морковью в сливочном соусе. Быстро, полезно и вкусно.', 30, 'Легко', 450, '1. Куриную грудку нарежьте небольшими кусочками.
2. Лук нарежьте полукольцами, морковь натрите на терке.
3. На разогретой сковороде с маслом обжарьте лук и морковь 3-4 минуты.
4. Добавьте курицу и жарьте до изменения цвета со всех сторон.
5. Брокколи разберите на соцветия, добавьте к курице.
6. Влейте сливки, добавьте соль и перец. Тушите под крышкой на среднем огне 15-20 минут до готовности курицы и брокколи.'),

-- Рецепт 2
('Гречневая каша с грибами и луком', 'Сытная и ароматная классика. Идеальный гарнир или самостоятельное блюдо.', 35, 'Легко', 320, '1. Гречку промойте, залейте водой в пропорции 1:2 и отварите до готовности.
2. Грибы нарежьте пластинками, лук - кубиком, морковь натрите.
3. На сковороде разогрейте масло, обжарьте лук до прозрачности.
4. Добавьте морковь, жарьте 5 минут.
5. Добавьте грибы и жарьте, пока не испарится жидкость.
6. Смешайте готовую гречку с грибной заправкой. Посолите и поперчите.'),

-- Рецепт 3
('Салат &quot;Цезарь&quot; с курицей', 'Популярный салат с хрустящими сухариками и соусом на основе йогурта.', 25, 'Средне', 380, '1. Куриную грудку отварите в подсоленной воде или обжарьте на гриле, нарежьте ломтиками.
2. Листья салата порвите руками.
3. Для соуса смешайте йогурт, горчицу, измельченный чеснок, соль и перец.
4. На тарелку выложите салат, курицу, сухарики.
5. Полейте соусом и сверху натрите сыр.'),

-- Рецепт 4
('Спагетти Карбонара', 'Итальянская паста с хрустящим беконом и сливочно-яичным соусом.', 20, 'Средне', 550, '1. Отварите спагетти в подсоленной воде согласно инструкции на упаковке.
2. Бекон нарежьте соломкой и обжарьте до хрустящей корочки.
3. В миске взбейте яйца со сливками, тертым сыром, солью и перцем.
4. Слейте воду со спагетти, оставив немного (половник) воды от пасты.
5. Выключите огонь под беконом. Добавьте к нему горячие спагетти и быстро перемешайте.
6. Влейте яично-сливочную смесь, интенсивно помешивая, чтобы яйца не свернулись, а превратились в крем. При необходимости добавьте немного воды от пасты.'),

-- Рецепт 5
('Омлет с помидорами и зеленью', 'Легкий, пышный завтрак, богатый белком.', 15, 'Легко', 280, '1. Помидоры нарежьте кубиком, зелень мелко порубите.
2. Яйца взбейте с молоком, солью и перцем.
3. На сковороде растопите масло, обжарьте помидоры 2-3 минуты.
4. Залейте яичной смесью, посыпьте зеленью.
5. Накройте крышкой и жарьте на среднем огне 5-7 минут до готовности.'),

-- Рецепт 6
('Суп с фрикадельками и рисом', 'Наваристый, домашний суп, который понравится и детям, и взрослым.', 40, 'Легко', 220, '1. Из фарша сформируйте небольшие фрикадельки.
2. Картофель нарежьте кубиками, морковь натрите, лук мелко нарежьте.
3. В кипящую подсоленную воду опустите фрикадельки и варите 10 минут.
4. Добавьте картофель, морковь, лук и рис. Варите 15 минут.
5. За 5 минут до готовности добавьте лавровый лист.
6. Подавайте с зеленью.'),

-- Рецепт 7
('Запеченный лосось с лимоном', 'Нежная рыба с цитрусовыми нотками. Простое и элегантное блюдо.', 25, 'Легко', 350, '1. Духовку разогрейте до 200°C.
2. Лосося натрите солью, перцем и оливковым маслом.
3. Лимон нарежьте тонкими кружочками.
4. На противень выложите лимонные дольки, сверху поместите лосося.
5. Запекайте 15-20 минут до готовности.
6. Подавайте с долькой лимона и зеленью.'),

-- Рецепт 8
('Творожная запеканка с яблоками', 'Нежный десерт на завтрак или полдник.', 45, 'Легко', 320, '1. Духовку разогрейте до 180°C.
2. Творог протрите через сито или взбейте блендером.
3. Добавьте яйца, сахар, манку и сметану, тщательно перемешайте.
4. Яблоки очистите от кожуры и сердцевины, нарежьте тонкими дольками.
5. Форму смажьте маслом, выложите творожную массу, сверху разложите яблоки.
6. Выпекайте 30-35 минут до золотистой корочки.'),

-- Рецепт 9
('Овощное рагу с кабачками', 'Летнее легкое блюдо из свежих овощей.', 35, 'Легко', 180, '1. Все овощи нарежьте кубиками среднего размера.
2. На сковороде разогрейте масло, обжарьте лук до прозрачности.
3. Добавьте морковь, жарьте 5 минут.
4. Добавьте кабачки, болгарский перец и помидоры. Тушите 10 минут.
5. Добавьте томатную пасту, соль, перец и специи. Тушите под крышкой еще 10-15 минут до мягкости овощей.
6. Перед подачей посыпьте зеленью.'),

-- Рецепт 10
('Фруктовый салат с йогуртом', 'Освежающий витаминный десерт.', 10, 'Легко', 150, '1. Все фрукты вымойте и очистите при необходимости.
2. Яблоки, груши, бананы и киви нарежьте кубиками.
3. В глубокой миске смешайте все фрукты.
4. Заправьте натуральным йогуртом и аккуратно перемешайте.
5. Можно добавить мед по вкусу.
6. Подавайте сразу после приготовления.');

-- Теперь добавляем ингредиенты для каждого рецепта
-- Рецепт 1: Куриная грудка с овощами в сливочном соусе
INSERT INTO RECIPE_INGREDIENT (recipe_id, product_id, quantity, unit) VALUES
(1, (SELECT id FROM PRODUCTS WHERE name = 'Куриная грудка'), 300, 'г'),
(1, (SELECT id FROM PRODUCTS WHERE name = 'Брокколи'), 200, 'г'),
(1, (SELECT id FROM PRODUCTS WHERE name = 'Морковь'), 100, 'г'),
(1, (SELECT id FROM PRODUCTS WHERE name = 'Сливки'), 200, 'мл'),
(1, (SELECT id FROM PRODUCTS WHERE name = 'Лук репчатый'), 100, 'г'),
(1, (SELECT id FROM PRODUCTS WHERE name = 'Масло сливочное'), 20, 'г'),
(1, (SELECT id FROM PRODUCTS WHERE name = 'Соль'), 5, 'г'),
(1, (SELECT id FROM PRODUCTS WHERE name = 'Перец черный молотый'), 2, 'г');

