olumn index="6" value="79"/></column_widths><filter_values><column index="1" value="мас"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="71"/><column index="2" value="35"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Удаляем таблицу если существует и создаем заново
DROP TABLE IF EXISTS products;
CREATE TABLE &quot;products&quot; (
	&quot;id&quot;	INTEGER NOT NULL,
	&quot;name&quot;	TEXT NOT NULL,
	&quot;category&quot;	TEXT NOT NULL,
	&quot;default_unit&quot;	TEXT NOT NULL,
	&quot;calories_per_100g&quot;	INTEGER NOT NULL,
	&quot;barcode&quot;	TEXT NOT NULL,
	PRIMARY KEY(&quot;id&quot; AUTOINCREMENT)
);

-- Вставляем продукты с правильными id
